# Kopiere diese Datei nach ".env" und trage deine Werte ein.

# --- Telegram (von @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Deine Telegram-ID (der Bot sagt sie dir beim ersten /start). Mehrere mit Komma trennen.
ALLOWED_TELEGRAM_USER_IDS=

# --- Claude (Kartenerkennung), Schlüssel von console.anthropic.com ---
ANTHROPIC_API_KEY=

# --- eBay (developer.ebay.com) ---
# "sandbox" zum Testen, "production" für echte Verkäufe
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
# Wird von "python ebay_login.py" automatisch eingetragen:
EBAY_REFRESH_TOKEN=

# --- Optional ---
# Richtlinien-IDs (leer = die erste Richtlinie aus deinem eBay-Konto wird genommen)
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
# Mindestpreis in Euro
MIN_PRICE=0.99
# Kostenloser Schlüssel von pokemontcg.io (höhere Abfragegrenze)
POKEMONTCG_API_KEY=
SHIPPING_NOTE=Die Karte wird sicher in Kartenhülle und Toploader verschickt.
